{
  "name": "TF Logistics",
  "dataColors": ["#1F4E79", "#2E9C8F", "#F2A541", "#7A8B99", "#5B7DB1", "#9BC9C1", "#C9D6E3", "#D64545"],
  "good": "#2E9C8F",
  "neutral": "#F2A541",
  "bad": "#D64545",
  "maximum": "#1F4E79",
  "center": "#9BC9C1",
  "minimum": "#EAF1F7",
  "foreground": "#1B2733",
  "foregroundNeutralSecondary": "#5F6B76",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6F9",
  "tableAccent": "#1F4E79",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#1B2733" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B2733" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F6B76" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E6EC" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{ "show": true, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#1B2733" } } }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}

model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_customer","dim_driver","dim_location","dim_subcontractor","dim_vehicle","fact_leg","fact_manifest","DataFolder","dim_route"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customer
ref table dim_driver
ref table dim_location
ref table dim_subcontractor
ref table dim_vehicle
ref table fact_leg
ref table fact_manifest
ref table _Measure
ref table dim_date
ref table dim_route

ref cultureInfo en-US


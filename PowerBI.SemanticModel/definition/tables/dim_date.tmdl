		summarizeBy: none
		sortByColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column 'Month Short' = FORMAT(dim_date[Date], "MMM yy")
		lineageTag: a835fc07-d015-4369-8568-8e8d79ac9b85
		summarizeBy: none
		sortByColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDARAUTO (),
				    "Year", YEAR ( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Weekday No", WEEKDAY ( [Date], 2 ),
				    "Weekday", FORMAT ( [Date], "ddd" ),
				    "Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1
				)

	annotation PBI_Id = f0ca7586a12345f3a9a047a1deb7421b

